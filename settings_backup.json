// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "github-copilot": {
      "default_model": "gpt-5-mini",
      "type": "registry",
    },
  },
  "status_bar": {
    "active_language_button": false,
    "active_encoding_button": "disabled",
    "cursor_position_button": false,
    "experimental.show": false,
  },
  "title_bar": {
    "show_sign_in": false,
    "show_branch_icon": false,
    "show_branch_name": false,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "project_panel": {
    "button": false,
    "dock": "right",
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "context_servers": {},
  "ssh_connections": [
    {
      "host": "98.95.142.222",
      "username": "bitnami",
      "args": ["-i", "~/keys/LightsailDefaultKey-us-east-1.pem"],
      "projects": [
        {
          "paths": ["/home/bitnami/Niklaar-backend/./"],
        },
      ],
    },
  ],
  // "use_podman": true,
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "which_key": {
    "delay_ms": 500,
    "enabled": true,
  },
  "colorize_brackets": true,
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "model_parameters": [],
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "tailwindcss-language-server",
        "!solargraph",
        "!rubocop",
      ],
    },
    "Python": {
      "language_servers": ["ty", "!basedpyright"],
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "html+erb": "html",
          "ruby": "html",
        },
        "experimental": {
          "classRegex": ["\\bclass:\\s*['\"]([^'\"]*)['\"]"],
        },
      },
    },
  },
  "edit_predictions": {
    "mode": "eager",
  },
  // "sticky_scroll": {
  //   "enabled": true,
  // },
  "features": {
    // "edit_prediction_provider": "supermaven"
    "edit_prediction_provider": "supermaven",
  },
  "file_finder": {
    "modal_max_width": "xlarge",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "relative_line_numbers": "enabled",
  "use_smartcase_search": true,
  "double_click_in_multibuffer": "open",
  "show_whitespaces": "none",
  "vim_mode": true,
  // "base_keymap": "Emacs",
  "ui_font_family": "Iosevka Nerd Font",
  "buffer_font_family": "Iosevka Nerd Font",
  "terminal": {
    "dock": "right",
    "font_family": "Iosevka Nerd Font",
    "font_weight": 700,
  },
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "active_pane_modifiers": {
    "border_size": 1,
    "inactive_opacity": 0.8,
  },
  "buffer_font_weight": 700,
  "ui_font_weight": 700,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "diagnostics": {
    "inline": {
      "max_severity": "error",
      "enabled": true,
      "padding": 2,
    },
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
  },
  "indent_guides": {
    "enabled": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "theme": "One Dark Pro Max",
}
