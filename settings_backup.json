//
// Zed settings
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "diff_view_style": "unified",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "github-copilot": {
      "default_model": "gpt-5-mini",
      "type": "registry",
    },
  },
  "status_bar": {
    "active_language_button": false,
    "active_encoding_button": "disabled",
    "cursor_position_button": false,
    "experimental.show": false,
  },
  "title_bar": {
    "show_sign_in": true,
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_user_menu": true,
    "show_user_picture": true,
  },
  "project_panel": {
    "button": false,
    "dock": "right",
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "context_servers": {
    "dart-mcp-server": {
      "enabled": true,
      "remote": false,
      "command": "dart",
      "args": ["mcp-server"],
      "env": {},
    },
  },
  "ssh_connections": [
    {
      "host": "98.95.142.222",
      "username": "bitnami",
      "args": ["-i", "~/keys/LightsailDefaultKey-us-east-1.pem"],
      "projects": [
        {
          "paths": ["/home/bitnami/Niklaar-backend/./"],
        },
      ],
    },
  ],
  // "use_podman": true,
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "which_key": {
    "delay_ms": 500,
    "enabled": true,
  },
  "colorize_brackets": true,
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "play_sound_when_agent_done": "when_hidden",
    "show_turn_stats": true,
    "default_width": 300.0,
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "effort": "high",
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "model_parameters": [],
  },
  "language_models": {
    "lmstudio": {
      "available_models": [
        {
          "display_name": "Qwen 3 (1.7b)",
          "max_tokens": 32000,
          "name": "qwen/qwen3-1.7b",
          "supports_images": true,
          "supports_tool_calls": true,
        },
      ],
    },
  },
  "languages": {
    "Ruby": {
      "format_on_save": "on",
      "language_servers": [
        "ruby-lsp",
        "tailwindcss-language-server",
        "rubocop",
        "herb",
        "!steep",
        "!solargraph",
      ],
    },
    "HTML+ERB": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "erb-format",
          "arguments": ["--stdin-filename", "{buffer_path}"],
        },
      },
      "language_servers": [
        "herb",
        "emmet-language-server",
        "ruby-lsp",
        "tailwindcss-language-server",
      ],
    },
    "Python": {
      "language_servers": ["ty", "!basedpyright"],
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "html+erb": "html",
          "ruby": "html",
        },
        "experimental": {
          "classRegex": ["\\bclass:\\s*['\"]([^'\"]*)['\"]"],
        },
      },
    },
    "ruby-lsp": {
      "initialization_options": {},
    },
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager",
  },
  // "sticky_scroll": {
  //   "enabled": true,
  // },
  "file_finder": {
    "modal_max_width": "small",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "relative_line_numbers": "enabled",
  "use_smartcase_search": true,
  "double_click_in_multibuffer": "open",
  "show_whitespaces": "none",
  "vim_mode": true,
  // "base_keymap": "Emacs",
  "ui_font_family": "Iosevka Nerd Font",
  "buffer_font_family": "Iosevka Nerd Font",
  "terminal": {
    "dock": "bottom",
    "font_family": "Iosevka Nerd Font",
    "font_weight": 600,
  },
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "active_pane_modifiers": {
    "border_size": 1,
    "inactive_opacity": 0.8,
  },
  "buffer_font_weight": 700,
  "ui_font_weight": 600,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "diagnostics": {
    "inline": {
      "max_severity": "error",
      "enabled": true,
      "padding": 2,
    },
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
  },
  "indent_guides": {
    "enabled": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Soft",
    "dark": "Catppuccin Mocha",
  },
}
